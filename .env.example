OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD="change-me"

API_PORT=3333

EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
EMBEDDING_DIM=1024
EMBEDDING_DTYPE=q8
EMBEDDING_REMOTE_URL=http://localhost:3333
# Embedding pool. The API runs the model in EMBED_CONCURRENCY child processes
# (1 is usually right — ORT already uses every core, and each resident model
# costs ~1.4 GB). Jobs queue; above EMBED_QUEUE_MAX callers get 503, and a job
# waiting longer than EMBED_QUEUE_TIMEOUT_MS fails as "busy" without killing
# anyone. EMBED_TIMEOUT_MS is the per-text stall budget: only a gap that long
# counts as wedged, and then just that one child is replaced.
# EMBED_CONCURRENCY=1
# EMBED_QUEUE_MAX=64
# EMBED_QUEUE_TIMEOUT_MS=90000
# EMBED_TIMEOUT_MS=90000
